#include <fstream>

using namespace std;

ifstream fin("unice.in");
ofstream fout("unice.out");

int main()
{
    int n, x, f[100] = {0};
    fin >> n;
    for(int i=1; i<=n; i++)
    {
        fin >> x;
        if(x<100)
        {
            f[x]++;
        }
    }
    
    for(int i=0; i<=99; i++)
    {
         if(f[i]==1)
         {
             fout << i << " ";
         }
    }
    return 0;
}
